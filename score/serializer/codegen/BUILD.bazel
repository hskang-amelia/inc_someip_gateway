load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@score_tooling//:defs.bzl", "score_py_pytest")

py_library(
    name = "someip_codegen_lib",
    srcs = ["someip_codegen.py"],
    imports = ["."],
)

py_binary(
    name = "someip_codegen",
    srcs = ["someip_codegen.py"],
    visibility = ["//visibility:public"],
)

score_py_pytest(
    name = "someip_codegen_test",
    size = "small",
    srcs = ["someip_codegen_test.py"],
    deps = [":someip_codegen_lib"],
)
